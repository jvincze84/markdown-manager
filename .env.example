# --- Kötelező ---
# A git szerver HTTPS alap URL-je (token nélkül). A repókat a felületen kell felvenni („⚙ Repók”),
# a repó URL-je: <GIT_URL>/<repó útvonal>, pl. https://git.myserver.hu/csoport/repo.git
# (Régi, .git végű repó URL esetén az app első induláskor automatikusan átáll, lásd README.)
GIT_URL=https://git.myserver.hu
# Personal access token (írási joggal a push-hoz)
GIT_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# --- Opcionális ---
# Felhasználónév a tokenhez (GitHub/GitLab: bármi jó, pl. oauth2; Bitbucket: x-token-auth)
GIT_USERNAME=oauth2
# Új repó felvételekor az alapértelmezett alap branch (repónként a felületen módosítható)
GIT_BRANCH=main
# Szerkesztési branchek előtagja → pl. md-edit/docs__guide__install.md
EDIT_BRANCH_PREFIX=md-edit/
# Commit szerző
GIT_AUTHOR_NAME=Markdown Manager
GIT_AUTHOR_EMAIL=markdown-manager@example.com
# Egyedi CA bundle (PEM, base64-ben), pl.: base64 -w0 ca.pem
# A rendszer CA-k mellé fűzi hozzá, így a publikus tanúsítványok továbbra is érvényesek.
GIT_CA_BUNDLE_BASE64=
# Opcionális Basic Auth a webes felülethez
APP_USERNAME=
APP_PASSWORD=
